# Copy to .env and fill in. Never commit .env.

# ---- App ----
# APP_ENV: local | staging | production
APP_ENV=local
LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:3000

# ---- LLM (chat) ----
# LLM_PROVIDER: anthropic. Use claude-haiku-5-5 for development, claude-sonnet-5-5 for the demo.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# ---- Embeddings (behind an interface; fastembed is local, no API key) ----
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---- RAG ----
# KB_PUBLIC_ONLY=true in deployed environments: only openly licensed sources are retrieved.
KB_PUBLIC_ONLY=false
# Best cosine similarity below this => "I don't know" (calibrated for bge-small, see ADR 0005).
RAG_MIN_SCORE=0.70

# ---- Database (Postgres + pgvector, from docker-compose) ----
DATABASE_URL=postgresql+psycopg://medagent:medagent@localhost:5432/medagent

# ---- Observability ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Auth ----
# JWT_SECRET signs login tokens: anyone who knows it can forge a login for any user.
# Generate a strong one (48 random bytes) and paste the output here; never commit it:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# The placeholder below is accepted ONLY with APP_ENV=local; other environments refuse to start.
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60

# ---- Demo protection (the API is public and spends real money per chat message) ----
MAX_MESSAGE_CHARS=1000
DAILY_MESSAGE_LIMIT=50      # per user per UTC day
DAILY_BUDGET_USD=1.00       # estimated spend across ALL users per UTC day; then no LLM calls
CHAT_RATE_PER_MINUTE=20     # per user
LOGIN_RATE_PER_MINUTE=10    # per IP
REGISTER_RATE_PER_HOUR=5    # per IP

# ---- Clinic ----
# Working hours are defined in this timezone; stored timestamps are always UTC.
CLINIC_TIMEZONE=Europe/Berlin
SLOT_MINUTES=30
# Language of public-holiday names in replies: en_US | de
HOLIDAY_LANGUAGE=en_US

# ---- Tools ----
# TOOLS_TRANSPORT: mcp (graph calls the MCP server over stdio) | local (in-process, used by tests)
TOOLS_TRANSPORT=mcp

# ---- Google Calendar (optional; leave empty to skip the calendar step) ----
# Service-account JSON key in secrets/ (git-ignored) + the ID of ONE shared demo calendar
# ("...@group.calendar.google.com"). Not "primary": that is the service account's own invisible calendar.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=

# ---- OpenStreetMap (nearby clinics; public instance by default, may be slow under load) ----
OVERPASS_URL=https://overpass-api.de/api/interpreter

# ---- Tracing with Langfuse (optional; leave the keys empty to switch it off) ----
# Create a project at https://cloud.langfuse.com (EU) and copy its API keys here (docs/SETUP.md).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com   # US: https://us.cloud.langfuse.com
LANGFUSE_ENABLED=true
# false (default): message text, passages and ids are redacted before they leave your machine.
# true: only for local development and eval runs on synthetic questions, never for the public demo.
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_SAMPLE_RATE=1.0        # share of turns traced (the free tier allows 50k units a month)

# ---- Evaluation tooling (scripts/run_evals.py) ----
# ragas and DeepEval send anonymous usage events by default. The eval code switches that off itself
# (medagent/evals/telemetry.py forces these and checks them after import), so nothing is needed
# here; these are the equivalents if you ever run either library by hand:
# RAGAS_DO_NOT_TRACK=true
# DEEPEVAL_TELEMETRY_OPT_OUT=YES
