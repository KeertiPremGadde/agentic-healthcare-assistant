# Copy to .env and fill in. Never commit .env.

# ---- App ----
# APP_ENV: local | staging | production
APP_ENV=local
LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:3000

# ---- LLM ----
# LLM_PROVIDER: openai | anthropic. Pick a current model for LLM_MODEL.
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ---- Database (Postgres + pgvector, from docker-compose) ----
DATABASE_URL=postgresql+psycopg://medagent:medagent@localhost:5432/medagent

# ---- Observability ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Auth ----
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60

# ---- Google Calendar (Phase 4) ----
GOOGLE_CLIENT_SECRETS_FILE=secrets/google_credentials.json
GOOGLE_CALENDAR_ID=primary

# ---- Clinic ----
# Working hours are defined in this timezone; stored timestamps are always UTC.
CLINIC_TIMEZONE=Europe/Berlin
SLOT_MINUTES=30
