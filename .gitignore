!data/processed/.gitkeep
evals/results/*
!evals/results/.gitkeep

# ---------- Frontend ----------
node_modules/
frontend/.next/
frontend/out/
*.tsbuildinfo
next-env.d.ts

# ---------- Infra ----------
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl

# ---------- OS / IDE ----------
.DS_Store
Thumbs.db
.idea/
