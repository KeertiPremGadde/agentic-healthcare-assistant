# ---------- Secrets (NEVER commit) ----------
.env
.env.*
!.env.example
credentials.json
token.json
token.pickle
*.pem
*.key
secrets/

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-eggs/

# ---------- Tooling caches ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/

# ---------- Local data ----------
*.db
*.sqlite3
data/raw/*
data/processed/*
