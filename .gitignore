# ---------- Secrets (NEVER commit) ----------
.env
.env.*
!.env.example
credentials.json
token.json
token.pickle
*.pem
*.key
secrets/

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-eggs/

# ---------- Tooling caches ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/

# ---------- Local data ----------
*.db
*.sqlite3
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# Result folders such as evals/results/baseline-*/ and one per kept or rejected change are
# committed (plain `git add <path>`). Only the runner's scratch output and the unreviewed
# red-team dump stay local.
evals/results/runs/
evals/results/redteam_router.json

# ---------- Frontend ----------
node_modules/
frontend/.next/
frontend/out/
*.tsbuildinfo
next-env.d.ts

# ---------- Infra ----------
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl

# ---------- OS / IDE ----------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ---------- Logs ----------
*.log
logs/
.cache/
